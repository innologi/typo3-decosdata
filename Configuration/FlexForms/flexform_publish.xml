<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<T3DataStructure>
	<meta>
		<langDisable>1</langDisable>
	</meta>
	<sheets>
		<sDEF>
			<ROOT>
				<sheetTitle>Overrides</sheetTitle>
				<type>array</type>
				<el>
					<settings.override.import>
						<label>Import override</label>
						<config>
							<type>group</type>
							<allowed>tx_decosdata_domain_model_import</allowed>
							<size>4</size>
							<autoSizeMax>10</autoSizeMax>
							<maxitems>9999</maxitems>
							<fieldControl>
								<elementBrowser>
									<disabled>1</disabled>
								</elementBrowser>
							</fieldControl>
						</config>
					</settings.override.import>
					<settings.override.publish>
						<label>TypoScript override</label>
						<config>
							<type>text</type>
							<renderType>codeEditor</renderType>
							<format>typoscript</format>
							<default></default>
						</config>
					</settings.override.publish>
				</el>
			</ROOT>
		</sDEF>
	</sheets>
</T3DataStructure>
