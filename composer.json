{
	"name": "innologi/typo3-decosdata",
	"type": "typo3-cms-extension",
	"description": "Import Decos XML exports locally and flexibly publish their contents. Successor to the 'decospublisher' extension.",
	"license": "GPL-2.0+",
	"authors": [{
			"name": "Frenck Lutke",
			"email": "typo3@innologi.nl",
			"homepage": "http://www.innologi.nl",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=8.2",
		"typo3/cms-core": "^13.4",
		"typo3/cms-scheduler": "^13.4",
		"bmack/modern-template-building": "dev-master#2fea36b3f4384884b31a98f997a7e326a4d06e50",
		"friendsoftypo3/typo3db-legacy": "dev-main#3b392dcba06a0bd82a5ef657ad4d28b5b7929ec5",
		"innologi/tag-builder": "~0.1.4",
		"innologi/trace-logger": "~0.1.1",
		"innologi/typo3-fal-api": "^1.0",
		"innologi/typo3-asset-provider": "^1.1"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "decosdata"
		}
	},
	"autoload": {
		"psr-4": {
			"Innologi\\Decosdata\\": "Classes/"
		}
	},
	"replace": {
		"typo3-ter/decosdata": "self.version"
	}
}